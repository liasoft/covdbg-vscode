{
    "name": "covdbg",
    "displayName": "covdbg",
    "description": "Native Windows C++ coverage in VS Code. Run coverage, inspect inline results, browse reports, and rerun test binaries from the Testing UI.",
    "version": "1.0.1",
    "author": "Liasoft GmbH",
    "publisher": "covdbg",
    "license": "Apache-2.0",
    "icon": "icon.png",
    "repository": {
        "type": "git",
        "url": "https://github.com/liasoft/covdbg-vscode.git"
    },
    "homepage": "https://github.com/liasoft/covdbg-vscode",
    "bugs": {
        "url": "https://github.com/liasoft/covdbg-vscode/issues"
    },
    "engines": {
        "vscode": "^1.140.0"
    },
    "categories": [
        "Testing",
        "Visualization",
        "AI"
    ],
    "keywords": [
        "coverage",
        "covdbg",
        "code coverage",
        "cpp code coverage",
        "testing",
        "ai assisted cpp coverage"
    ],
    "activationEvents": [
        "workspaceContains:**/.covdbg.yaml",
        "workspaceContains:**/*.covdb",
        "workspaceContains:**/CMakeLists.txt",
        "workspaceContains:**/*.sln",
        "workspaceContains:**/*.vcxproj",
        "onMcpCollection:covdbg.mcp"
    ],
    "main": "./out/extension.js",
    "covdbgBundledVersion": "1.5.0",
    "capabilities": {
        "untrustedWorkspaces": {
            "supported": "limited",
            "description": "covdbg can view existing .covdb files in Restricted Mode, but running coverage binaries requires workspace trust.",
            "restrictedConfigurations": [
                "covdbg.executablePath",
                "covdbg.runner.workingDirectory",
                "covdbg.runner.configPath",
                "covdbg.runner.outputPath",
                "covdbg.runner.binaryDiscoveryPattern",
                "covdbg.runner.env"
            ]
        }
    },
    "contributes": {
        "commands": [
            {
                "command": "covdbg.showMenu",
                "title": "Open Menu",
                "category": "covdbg"
            },
            {
                "command": "covdbg.toggleCoverage",
                "title": "Toggle Coverage Display",
                "category": "covdbg"
            },
            {
                "command": "covdbg.showReport",
                "title": "Show Coverage Report",
                "category": "covdbg"
            },
            {
                "command": "covdbg.browseFiles",
                "title": "Browse Covered Files",
                "category": "covdbg"
            },
            {
                "command": "covdbg.setRenderMode",
                "title": "Set Render Mode",
                "category": "covdbg"
            },
            {
                "command": "covdbg.configurePath",
                "title": "Load .covdb…",
                "category": "covdbg"
            },
            {
                "command": "covdbg.runCoverage",
                "title": "Run Coverage",
                "category": "covdbg",
                "icon": "$(play)"
            },
            {
                "command": "covdbg.chooseExecutable",
                "title": "Choose Executable…",
                "category": "covdbg"
            },
            {
                "command": "covdbg.createConfig",
                "title": "Create .covdbg.yaml",
                "category": "covdbg"
            },
            {
                "command": "covdbg.openConfig",
                "title": "Open or Create .covdbg.yaml",
                "category": "covdbg"
            },
            {
                "command": "covdbg.openLog",
                "title": "Open covdbg.log",
                "category": "covdbg"
            },
            {
                "command": "covdbg.showOutput",
                "title": "Show Log",
                "category": "covdbg"
            },
            {
                "command": "covdbg.refresh",
                "title": "Refresh",
                "category": "covdbg",
                "icon": "$(refresh)"
            },
            {
                "command": "covdbg.openSettings",
                "title": "Open Settings",
                "category": "covdbg"
            },
            {
                "command": "covdbg.clearLastRunResult",
                "title": "Clear Last Run",
                "category": "covdbg"
            },
            {
                "command": "covdbg.signIn",
                "title": "Sign In",
                "category": "covdbg"
            },
            {
                "command": "covdbg.signOut",
                "title": "Sign Out",
                "category": "covdbg"
            },
            {
                "command": "covdbg.copySignInCode",
                "title": "Copy Sign-In Code",
                "category": "covdbg",
                "icon": "$(copy)"
            },
            {
                "command": "covdbg.openSignInPage",
                "title": "Open Sign-In Page Again",
                "category": "covdbg",
                "icon": "$(link-external)"
            },
            {
                "command": "covdbg.cancelSignIn",
                "title": "Cancel Sign-In",
                "category": "covdbg",
                "icon": "$(close)"
            }
        ],
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "covdbg-sidebar",
                    "title": "covdbg",
                    "icon": "assets/covdbg-sidebar.svg"
                }
            ]
        },
        "views": {
            "covdbg-sidebar": [
                {
                    "id": "covdbg.homeView",
                    "name": "Coverage"
                }
            ]
        },
        "viewsWelcome": [
            {
                "view": "covdbg.homeView",
                "contents": "covdbg runs Windows executables locally, in a trusted workspace.\n[Manage Workspace Trust](command:workbench.trust.manage)",
                "when": "covdbg.welcome == untrusted"
            },
            {
                "view": "covdbg.homeView",
                "contents": "covdbg runs only in a local window, not a remote one.",
                "when": "covdbg.welcome == remote"
            },
            {
                "view": "covdbg.homeView",
                "contents": "covdbg runs only on Windows.",
                "when": "covdbg.welcome == platform"
            },
            {
                "view": "covdbg.homeView",
                "contents": "covdbg 1.4 or newer is needed.\n[Install covdbg](https://covdbg.com/download)\n[Refresh](command:covdbg.refresh)",
                "when": "covdbg.welcome == runtime"
            },
            {
                "view": "covdbg.homeView",
                "contents": "covdbg 1.4 or newer is needed. The covdbg.executablePath setting points at an older one.\n[Open Setting](command:workbench.action.openSettings?%5B%22covdbg.executablePath%22%5D)\n[Refresh](command:covdbg.refresh)",
                "when": "covdbg.welcome == runtimeSetting"
            },
            {
                "view": "covdbg.homeView",
                "contents": "Sign in to measure coverage. The account and team you sign in with decide which repositories are covered.\n[Sign in](command:covdbg.signIn)",
                "when": "covdbg.welcome == signedOut"
            },
            {
                "view": "covdbg.homeView",
                "contents": "No test executable found.\n[Choose Executable…](command:covdbg.chooseExecutable)\n[Refresh](command:covdbg.refresh)",
                "when": "covdbg.welcome == noTarget"
            }
        ],
        "mcpServerDefinitionProviders": [
            {
                "id": "covdbg.mcp",
                "label": "covdbg"
            }
        ],
        "menus": {
            "commandPalette": [
                {
                    "command": "covdbg.copySignInCode",
                    "when": "covdbg.auth == signingIn"
                },
                {
                    "command": "covdbg.cancelSignIn",
                    "when": "covdbg.auth == signingIn"
                },
                {
                    "command": "covdbg.openSignInPage",
                    "when": "covdbg.auth == signingIn"
                },
                {
                    "command": "covdbg.signIn",
                    "when": "covdbg.auth != signedIn && covdbg.auth != token && covdbg.auth != unavailable"
                },
                {
                    "command": "covdbg.signOut",
                    "when": "covdbg.auth == signedIn"
                },
                {
                    "command": "covdbg.setRenderMode",
                    "when": "false"
                },
                {
                    "command": "covdbg.toggleCoverage",
                    "when": "covdbg.hasCoverage"
                },
                {
                    "command": "covdbg.showReport",
                    "when": "covdbg.hasCoverage"
                },
                {
                    "command": "covdbg.browseFiles",
                    "when": "covdbg.hasCoverage"
                },
                {
                    "command": "covdbg.clearLastRunResult",
                    "when": "covdbg.hasCoverage || covdbg.hasNotice"
                }
            ],
            "testing/message/content": [
                {
                    "command": "covdbg.showOutput",
                    "when": "testMessage == covdbg.run"
                }
            ],
            "view/title": [
                {
                    "command": "covdbg.runCoverage",
                    "when": "view == covdbg.homeView",
                    "group": "navigation@1"
                },
                {
                    "command": "covdbg.refresh",
                    "when": "view == covdbg.homeView",
                    "group": "navigation@2"
                },
                {
                    "command": "covdbg.chooseExecutable",
                    "when": "view == covdbg.homeView",
                    "group": "1_config@1"
                },
                {
                    "command": "covdbg.openConfig",
                    "when": "view == covdbg.homeView",
                    "group": "1_config@2"
                },
                {
                    "command": "covdbg.configurePath",
                    "when": "view == covdbg.homeView",
                    "group": "2_coverage@1"
                },
                {
                    "command": "covdbg.showReport",
                    "when": "view == covdbg.homeView && covdbg.hasCoverage",
                    "group": "2_coverage@2"
                },
                {
                    "command": "covdbg.clearLastRunResult",
                    "when": "view == covdbg.homeView && (covdbg.hasCoverage || covdbg.hasNotice)",
                    "group": "2_coverage@3"
                },
                {
                    "command": "covdbg.openLog",
                    "when": "view == covdbg.homeView",
                    "group": "3_log@1"
                },
                {
                    "command": "covdbg.signOut",
                    "when": "view == covdbg.homeView && covdbg.auth == signedIn",
                    "group": "4_account@1"
                },
                {
                    "command": "covdbg.openSettings",
                    "when": "view == covdbg.homeView",
                    "group": "5_settings@1"
                }
            ],
            "view/item/context": [
                {
                    "command": "covdbg.copySignInCode",
                    "when": "view == covdbg.homeView && viewItem == signingIn",
                    "group": "inline@1"
                },
                {
                    "command": "covdbg.openSignInPage",
                    "when": "view == covdbg.homeView && viewItem == signingIn",
                    "group": "inline@2"
                },
                {
                    "command": "covdbg.cancelSignIn",
                    "when": "view == covdbg.homeView && viewItem == signingIn",
                    "group": "inline@3"
                },
                {
                    "command": "covdbg.runCoverage",
                    "when": "view == covdbg.homeView && viewItem == ready",
                    "group": "inline@1"
                }
            ]
        },
        "configuration": {
            "title": "covdbg",
            "properties": {
                "covdbg.covdbPath": {
                    "type": "string",
                    "default": "",
                    "markdownDescription": "Path to a `.covdb` file. Supports absolute paths or paths relative to the workspace root. The extension auto-loads this file on startup and reloads when it changes.",
                    "scope": "resource",
                    "order": 0
                },
                "covdbg.discoveryPattern": {
                    "type": "string",
                    "default": "**/*.covdb",
                    "markdownDescription": "Glob pattern used to auto-discover `.covdb` files in the workspace when `#covdbg.covdbPath#` is not set.",
                    "scope": "resource",
                    "order": 1
                },
                "covdbg.renderMode": {
                    "type": "string",
                    "enum": [
                        "line",
                        "gutter",
                        "both"
                    ],
                    "default": "gutter",
                    "enumDescriptions": [
                        "Highlight covered/uncovered lines with background colors",
                        "Show coverage indicators in the gutter only",
                        "Both line highlighting and gutter indicators"
                    ],
                    "markdownDescription": "How to visualise coverage in the editor.",
                    "scope": "resource",
                    "order": 1
                },
                "covdbg.showExternalFiles": {
                    "type": "boolean",
                    "default": false,
                    "markdownDescription": "Include files outside the workspace (e.g. SDK headers, system includes) in coverage results.",
                    "scope": "resource",
                    "order": 2
                },
                "covdbg.executablePath": {
                    "type": "string",
                    "default": "",
                    "markdownDescription": "Explicit path to `covdbg.exe`. If empty, covdbg 1.4.0 or newer is looked for on PATH, then in the known install folders, then the bundled portable copy.",
                    "scope": "resource",
                    "order": 3
                },
                "covdbg.portableCachePath": {
                    "type": "string",
                    "default": "",
                    "markdownDescription": "Optional cache folder for portable binaries. Leave empty to use extension global storage.",
                    "scope": "machine",
                    "order": 4
                },
                "covdbg.runner.targetArgs": {
                    "type": "array",
                    "default": [],
                    "items": {
                        "type": "string"
                    },
                    "markdownDescription": "Arguments passed to the selected test executable when running coverage.",
                    "scope": "resource",
                    "order": 5
                },
                "covdbg.runner.configPath": {
                    "type": "string",
                    "default": "",
                    "markdownDescription": "Optional path to `.covdbg.yaml` (absolute or workspace-relative). If empty, covdbg config is resolved automatically near the selected executable.",
                    "scope": "resource",
                    "order": 6
                },
                "covdbg.runner.outputPath": {
                    "type": "string",
                    "default": "",
                    "markdownDescription": "Where a run started from VS Code writes its `.covdb`. Leave empty for covdbg's own default, `.covdbg/coverage.covdb` under the run's working directory. A relative path is resolved from the workspace folder.",
                    "scope": "resource",
                    "order": 7
                },
                "covdbg.runner.binaryDiscoveryPattern": {
                    "type": "string",
                    "default": "{build,Build,out,Out,x64,cmake-build-*}/**/*{test,Test,TEST}*",
                    "markdownDescription": "Glob pattern used to discover test binaries for the Testing API integration.",
                    "scope": "resource",
                    "order": 9
                },
                "covdbg.runner.binaryDiscoveryExcludePattern": {
                    "type": "string",
                    "default": "**/{Release,RelWithDebInfo,cmake-build-release*,cmake-build-relwithdebinfo*}/**",
                    "markdownDescription": "Glob pattern for discovered test binaries to leave out. Excludes take precedence over `#covdbg.runner.binaryDiscoveryPattern#`. The default skips optimized build trees, whose binaries carry the symbols covdbg needs only in part; it is also useful when post-build steps copy matching executables into additional folders.",
                    "scope": "resource",
                    "order": 10
                },
                "covdbg.runner.workingDirectory": {
                    "type": "string",
                    "default": "",
                    "markdownDescription": "Working directory used for the covdbg process. Empty value uses workspace root.",
                    "scope": "resource",
                    "order": 14
                },
                "covdbg.runner.env": {
                    "type": "object",
                    "default": {},
                    "markdownDescription": "Additional environment variables passed to covdbg runs, for example `COVDBG_PROJECT_TOKEN` where runs should use a project token instead of the machine's sign-in.",
                    "scope": "resource",
                    "order": 15
                }
            }
        }
    },
    "scripts": {
        "prepare:portable": "node ./scripts/downloadPortable.js",
        "release:check": "npm run check:vscode-engine && node ./scripts/verifyBundledCovdbg.js && node ./scripts/verifyReleaseVersion.js",
        "check:vscode-engine": "node ./scripts/syncVscodeEngine.js --check",
        "sync:vscode-engine": "node ./scripts/syncVscodeEngine.js --write",
        "vscode:prepublish": "npm run build",
        "typecheck": "tsc -p ./ --noEmit",
        "bundle": "node ./scripts/bundle.js",
        "compile": "npm run check:vscode-engine && npm run typecheck && npm run bundle",
        "build": "npm run prepare:portable && npm run compile",
        "watch": "node ./scripts/bundle.js --watch",
        "package": "vsce package --skip-license",
        "compile:tests": "tsc -p ./tsconfig.tests.json",
        "pretest": "npm run compile && npm run compile:tests",
        "test": "node --test test-out/test/*.test.js",
        "test:e2e": "npm run compile && npm run compile:tests && node test-out/e2e/runE2e.js",
        "pretest:coverage": "npm run compile && npm run compile:tests",
        "test:coverage": "c8 --reporter=text --reporter=lcov --reports-dir=coverage --include=\"test-out/**/*.js\" --exclude=\"test-out/test/**/*.test.js\" node --test test-out/test/*.test.js",
        "lint": "eslint src",
        "format": "prettier --write .",
        "format:silent": "prettier --write . --log-level silent",
        "format:check": "prettier --check ."
    },
    "devDependencies": {
        "@types/js-yaml": "^4.0.9",
        "@types/node": "^24.13.3",
        "@types/sql.js": "^1.4.11",
        "@types/vscode": "^1.140.0",
        "@typescript-eslint/eslint-plugin": "^8.71.1",
        "@typescript-eslint/parser": "^8.68.0",
        "@vscode/test-electron": "^3.1.0",
        "@vscode/vsce": "^4.0.0",
        "c8": "^12.0.0",
        "esbuild": "^0.28.2",
        "eslint": "^10.12.0",
        "js-yaml": "^5.4.3",
        "prettier": "^3.9.9",
        "sql.js": "^1.14.2",
        "typescript": "^6.0.3"
    }
}
